# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres connection string. Neon, Supabase, RDS — anything Postgres 14+.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Port the API listens on. In production this process also serves dist/.
PORT=8787

# development | production
NODE_ENV=development

# Comma-separated browser origins allowed to make credentialed API calls.
# REQUIRED in production. Ignored in development.
# e.g. ALLOWED_ORIGINS="https://nuto.in,https://www.nuto.in"
ALLOWED_ORIGINS=""

# Frontend only: set in Netlify's build environment to the Cloud Run API URL.
# It is intentionally absent from the server environment.
# VITE_API_URL="https://nuto-api-<hash>.asia-south1.run.app"

# Used ONLY by `pnpm db:seed` to create the first admin user.
# Remove them from the environment once the admin exists.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-long-random-password"
