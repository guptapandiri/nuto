{
  "name": "nuto-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed.ts",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "hono": "^4.12.33",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
